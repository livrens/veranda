; Generated by Veranda - development defaults, hardened where it costs nothing.
; Edit {{EXTRA_INI}} for your own overrides; this file is rewritten on every start.

[PHP]
engine = On
short_open_tag = Off
precision = 14
output_buffering = 4096
zlib.output_compression = Off
implicit_flush = Off
serialize_precision = -1
zend.exception_ignore_args = Off
zend.exception_string_param_max_len = 15

; --- resources
max_execution_time = {{MAX_EXECUTION_TIME}}
max_input_time = 120
max_input_vars = 5000
memory_limit = {{MEMORY_LIMIT}}
post_max_size = {{UPLOAD_MAX}}
upload_max_filesize = {{UPLOAD_MAX}}
max_file_uploads = 50
file_uploads = On
upload_tmp_dir = "{{TMP_DIR}}"
sys_temp_dir = "{{TMP_DIR}}"

; --- errors: loud in development, but logged too
error_reporting = E_ALL
display_errors = On
display_startup_errors = On
log_errors = On
error_log = "{{LOG_DIR}}/php_errors.log"
html_errors = On
report_memleaks = On

; --- security
expose_php = Off
allow_url_fopen = On
allow_url_include = Off
enable_dl = Off
cgi.fix_pathinfo = 0
cgi.force_redirect = 0
mail.add_x_header = Off
disable_functions =
open_basedir =
user_ini.filename = ".user.ini"
user_ini.cache_ttl = 300

; --- paths
default_charset = "UTF-8"
include_path = "."
{{EXTENSION_DIR}}
date.timezone = "{{TIMEZONE}}"

; --- sessions
session.save_handler = files
session.save_path = "{{SESSION_DIR}}"
session.use_strict_mode = 1
session.use_cookies = 1
session.use_only_cookies = 1
session.cookie_httponly = 1
session.cookie_samesite = "Lax"
session.name = PHPSESSID
session.gc_probability = 1
session.gc_divisor = 1000
session.gc_maxlifetime = 1440

; --- opcache (fast reloads for development)
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 192
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files = 20000
opcache.validate_timestamps = 1
opcache.revalidate_freq = 0
opcache.jit = tracing
opcache.jit_buffer_size = 64M

{{OPCACHE_PLATFORM}}
realpath_cache_size = 4096k
realpath_cache_ttl = 120

; --- extensions ({{PLATFORM}})
{{EXTENSIONS}}

; --- user overrides (kept across regenerations)
{{EXTRA_INCLUDE}}
