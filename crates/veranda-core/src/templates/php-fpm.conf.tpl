; Generated by Veranda - php-fpm pool bound to loopback only.
[global]
pid = {{RUN_DIR}}/php-fpm.internal.pid
error_log = {{LOG_DIR}}/php-fpm.log
log_level = notice
daemonize = no

[www]
listen = 127.0.0.1:{{PORT}}
listen.allowed_clients = 127.0.0.1
pm = dynamic
pm.max_children = {{MAX_CHILDREN}}
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 4
pm.max_requests = 1000
request_terminate_timeout = {{MAX_EXECUTION_TIME}}s
catch_workers_output = yes
decorate_workers_output = no
clear_env = no
env[PATH] = {{PATH}}
php_admin_value[error_log] = {{LOG_DIR}}/php_errors.log
