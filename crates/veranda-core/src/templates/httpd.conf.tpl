# Generated by Veranda - development server, loopback only.
ServerRoot "{{SERVER_ROOT}}"
Listen 127.0.0.1:{{HTTP_PORT}}
Listen [::1]:{{HTTP_PORT}}
{{SSL_LISTEN}}
PidFile "{{RUN_DIR}}/httpd.internal.pid"
DefaultRuntimeDir "{{RUN_DIR}}"
ServerName localhost
ServerTokens Prod
ServerSignature Off
TraceEnable Off
Timeout 300
KeepAlive On
MaxKeepAliveRequests 100
KeepAliveTimeout 5
HostnameLookups Off
ErrorLog "{{LOG_DIR}}/apache-error.log"
LogLevel warn
LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
CustomLog "{{LOG_DIR}}/apache-access.log" combined
TypesConfig "{{MIME_TYPES}}"
AddType application/x-httpd-php .php
DirectoryIndex index.php index.html index.htm
{{UNIX_USER}}
{{MODULES}}
{{MUTEX}}

<Directory />
    AllowOverride None
    Require all denied
</Directory>
<FilesMatch "^\.(ht|env|git)">
    Require all denied
</FilesMatch>
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"

<IfModule ssl_module>
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLCipherSuite ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
    SSLHonorCipherOrder off
    SSLSessionCache "shmcb:{{RUN_DIR}}/ssl_scache(512000)"
    SSLSessionCacheTimeout 300
</IfModule>

<Proxy "balancer://verandaphp">
{{PHP_MEMBERS}}
</Proxy>
<FilesMatch "\.php$">
    SetHandler "{{PHP_HANDLER}}"
</FilesMatch>
ProxyTimeout {{MAX_EXECUTION_TIME}}
{{FCGI_ENV}}

{{VHOSTS}}
